---
import {getCollection} from 'astro:content';
import EventCard from '../components/EventCard.astro';
import MemoryCard from '../components/MemoryCard.astro';
import {sortedEvents,statusOf,countdown,dateLabel,fullDateLabel,money,progress,identities,labels} from '../lib/events.mjs';
import '../styles/global.css';
const events=sortedEvents((await getCollection('initiatives')).map(({id,data})=>({id,...data})));
const active=events.filter(e=>!['completed','made-possible'].includes(statusOf(e)));
const next=active.find(e=>e.date);const memories=events.filter(e=>['completed','made-possible'].includes(statusOf(e)));
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Birthdays, milestones, and the moments the Martin family is making together."/><meta name="theme-color" content="#faf8f3"/><title>The Martin Family · Our moments, together</title><link rel="icon" href="/favicon.svg"/></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="header wrap"><a class="brand" href="#home" aria-label="The Martin Family home"><span class="monogram">M<span>•</span></span><span>The Martin Family<small>OUR LITTLE CORNER OF THE WORLD</small></span></a><nav aria-label="Main navigation"><a href="#timeline">Timeline</a><a href="#kids">Our kids</a><a href="#memories">Memories</a></nav><button class="button help-button" data-help>♡ <span>Ways to help</span></button></header>
<main id="main"><section class="family-hero wrap" id="home"><img src="/images/family/family-under-bridge.jpg" alt="Three Martin children sitting together beneath leafy branches" fetchpriority="high" decoding="async"/><div class="family-hero-shade"></div><div class="family-hero-copy"><p class="eyebrow">WELCOME TO OUR FAMILY HUB</p><h1>The Martin<br/>Family</h1><p>Birthdays, milestones, performances, and the moments we’re making together.</p><span class="hero-handwritten">Same kids. Bigger stories. <b aria-hidden="true">♡</b></span></div></section>
<div class="next-up-wrap wrap"><aside class="next-card" aria-labelledby="next-title"><div class="next-top"><span class="eyebrow">NEXT UP</span><span class="countdown" id="next-countdown">{next?countdown(next.date):'More moments ahead'}</span></div><div id="next-content">{next?<><div class="date-block"><span>{new Date(next.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'short',timeZone:'UTC'})}</span><strong>{Number(next.date.slice(-2))}</strong><span>{next.date.slice(0,4)}</span></div><div class="next-body"><p class="eyebrow">{next.child.toUpperCase()}’S BIG DAY</p><h2 id="next-title">{next.title}</h2><p>{next.secret?'A special day. A little surprise. A whole lot of family love.':next.description}</p>{next.goal&&<p class="next-goal">{money(next.goal)} goal <span>·</span> {next.raised==null?'Update coming soon':`${money(next.raised)} funded`}</p>}<button class="button dark-button" data-contribute={next.id}>{next.cta}<span aria-hidden="true">↗</span></button></div></>:<h2 id="next-title">The next chapter is on its way.</h2>}</div><p class="next-foot">♡ The best part is making it happen together.</p></aside></div>
<section class="current wrap" id="kids"><div class="section-heading"><div><p class="eyebrow">A FEW THINGS TO LOOK FORWARD TO</p><h2>On our family’s horizon<span class="accent">.</span></h2></div><span class="small-note">Three kids. So many possibilities.</span></div><div class="event-grid" id="current-events">{active.map(event=><EventCard event={event}/>)}</div><p id="current-empty" hidden={active.length>0}>We’ll add our next family moments here soon.</p></section>
<section class="timeline-section" id="timeline"><div class="wrap timeline-layout"><div class="timeline-intro"><p class="eyebrow">ONE MOMENT AT A TIME</p><h2>What’s coming up?</h2><p>A little timeline of the days<br/>we’re looking forward to.</p><div class="family-initials" aria-label="Rashid, Kamaal, and Sophia"><span class="peach">R</span><span class="blue">K</span><span class="lilac">S</span><span class="family-heart">♡</span></div><figure class="timeline-family-photo"><img src="/images/family/family-portrait.jpg" alt="The three Martin children standing together and smiling" loading="lazy" decoding="async"/><figcaption>Together is our favorite place to be.</figcaption></figure></div><div class="timeline" id="timeline-events">{active.map(e=>{const eventProgress=progress(e);return <article class:list={['timeline-item',identities[e.child].color]} data-timeline-event={e.id}><div class="timeline-date">{e.date?<><span>{new Date(e.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'short',timeZone:'UTC'})}</span><strong>{Number(e.date.slice(-2))}</strong></>:<><span>DATE</span><strong class="tbd">TBC</strong></>}</div><div class="timeline-dot"></div><div class="timeline-card"><div class="timeline-copy"><p class="eyebrow">{e.child}</p><h3>{e.title}</h3><p>{e.date?dateLabel(e.date):'A milestone in the making'}</p>{e.fundingDeadline&&<p>Support by {fullDateLabel(e.fundingDeadline)}</p>}</div><div class="timeline-progress-area"><span class="badge" data-status>{labels[statusOf(e)]}</span>{e.goal!=null&&<div class="timeline-funding"><div class="timeline-funding-label"><strong>{e.raised==null?`${money(e.goal)} goal`:`${money(e.raised)} of ${money(e.goal)}`}</strong>{eventProgress&&<span>{eventProgress.percent}%</span>}</div>{eventProgress?<progress value={eventProgress.percent} max="100" aria-label={`${e.title} funding progress`}>{eventProgress.percent}%</progress>:<div class="unknown-progress" role="img" aria-label={`${e.title} funding total will be updated soon`}></div>}<small>{e.raised==null?'Funding update coming soon':eventProgress.remaining===0?'Goal reached':`${money(eventProgress.remaining)} to go`}</small></div>}</div></div></article>})}</div></div></section>
<section class="memories wrap" id="memories"><div class="section-heading"><div><p class="eyebrow">THE DAYS BECOME THE STORIES</p><h2>Recently made possible <span class="accent">♡</span></h2><p>Some of the moments our family helped make happen.</p></div></div><div id="memory-grid" class="memory-grid">{memories.map(e=><MemoryCard event={e}/>)}</div><div class="memory-empty" id="memory-empty" hidden={memories.length>0}><span class="memory-mark" aria-hidden="true">♡</span><div><h3>Good things are in the making.</h3><p>After the big days, this is where we’ll keep the photos,<br class="desktop-break"/> the smiles, and a little thank-you to family.</p></div><span class="handwritten">Room for our next memory.</span></div></section>
<section class="help-banner wrap"><div><p class="eyebrow">OUR FAMILY, OUR COMMUNITY</p><h2>It takes a village.</h2><p>Thank you for being part of our kids’ journey. Your support means everything.</p></div><button class="button dark-button" data-help>Ways to help <span aria-hidden="true">♡</span></button></section></main>
<footer class="wrap"><a class="brand footer-brand" href="#home"><span class="monogram">M<span>•</span></span>The Martin Family</a><p>It takes a village.</p><a href="#home">Back to top ↑</a></footer>
<dialog id="contribution-dialog" aria-labelledby="sheet-title"><div class="sheet-shell"><div class="sheet-handle" aria-hidden="true"></div><button class="close-button" id="close-sheet" aria-label="Close contribution options">×</button><div id="sheet-content"></div></div></dialog>
<script id="family-data" type="application/json" set:html={JSON.stringify(events).replace(/</g,'\\u003c')}/>
<script>import '../lib/client';</script>
</body></html>
