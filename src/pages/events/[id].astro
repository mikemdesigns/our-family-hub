---
import { getCollection } from 'astro:content';
import {
  statusOf,
  labels,
  statusDescriptions,
  money,
  progress,
  dateLabel,
  fullDateLabel,
  paymentOptions,
  imageSource,
  safeLink,
  identities,
} from '../../lib/events.mjs';
import '../../styles/global.css';
import '../../styles/identity-colors.css';

export async function getStaticPaths() {
  const entries = await getCollection('initiatives');

  return entries.map(({ id, data }) => ({
    params: { id },
    props: { event: { id, ...data } },
  }));
}

const { event: e } = Astro.props;
const state = statusOf(e);
const eventProgress = progress(e);
const identity = identities[e.child];
const cover = imageSource(e.photos?.coverImage);
const gallery = (e.photos?.gallery || [])
  .map((photo) => ({ ...photo, src: imageSource(photo.src) }))
  .filter((photo) => photo.src);
const coverAlt =
  gallery.find((photo) => photo.src === cover)?.alt || `${e.child} · ${e.title}`;
const methods = paymentOptions(e);
const album = safeLink(e.photos?.albumUrl);

const providerNames = {
  cashapp: 'Cash App',
  venmo: 'Venmo',
  zelle: 'Zelle',
  card: 'Card',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={e.description} />
    <meta name="theme-color" content="#faf8f3" />
    <title>{e.child} · {e.title} · The Martin Family</title>
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header wrap">
      <a class="brand" href="/" aria-label="The Martin Family home">
        <span class="monogram">M<span>•</span></span>
        <span>
          The Martin Family
          <small>OUR LITTLE CORNER OF THE WORLD</small>
        </span>
      </a>

      <nav aria-label="Main navigation">
        <a href="/#about">About</a>
        <a href="/#timeline">Timeline</a>
        <a href="/#thanks">Thank-yous</a>
        <a href="/#memories">Memories</a>
      </nav>

      <a class="button help-button" href="/#timeline">What’s coming up</a>
    </header>

    <main id="main" class:list={['event-detail-page', identity.color]}>
      <div class="wrap">
        <a class="event-back" href="/#timeline">← Back to what’s coming up</a>

        <article class="event-detail-card">
          <div class="event-detail-media">
            {
              cover ? (
                <img src={cover} alt={coverAlt} fetchpriority="high" decoding="async" />
              ) : (
                <div class="event-detail-placeholder">
                  <span class="avatar">{identity.initial}</span>
                  <p>More photos coming soon</p>
                </div>
              )
            }

            {
              e.secret && (
                <span class="secret-ribbon">
                  <span aria-hidden="true">✦</span> Shh—keep it a surprise
                </span>
              )
            }
          </div>

          <div class="event-detail-copy">
            <div class="event-detail-meta">
              <span class="identity">
                <span class="avatar">{identity.initial}</span>
                {e.child}
              </span>
              <span
                class:list={['badge', `status-${state}`]}
                title={statusDescriptions[state]}
              >
                {labels[state]}
              </span>
            </div>

            <p class="eyebrow category">{e.category}</p>
            <h1>{e.title}</h1>

            <p class="event-detail-date">
              {e.date
                ? dateLabel(e.date)
                : e.fundingDeadline
                  ? `Funding due ${fullDateLabel(e.fundingDeadline)}`
                  : 'Date to come'}
            </p>

            <p class="event-detail-description">{e.description}</p>

            {
              e.fundingDeadline && e.date && (
                <p class="event-detail-deadline">
                  Support by {fullDateLabel(e.fundingDeadline)}
                </p>
              )
            }

            {
              e.goal != null && (
                <section class="event-detail-funding" aria-label="Funding progress">
                  <div class="funding-numbers">
                    <span>
                      {e.raised == null ? (
                        <>
                          <strong>{money(e.goal)}</strong> goal
                        </>
                      ) : (
                        <>
                          <strong>{money(e.raised)}</strong> of {money(e.goal)}
                        </>
                      )}
                    </span>
                    {eventProgress && <strong>{eventProgress.percent}%</strong>}
                  </div>

                  {eventProgress ? (
                    <progress
                      value={eventProgress.percent}
                      max="100"
                      aria-label={`${e.child}: ${eventProgress.percent}% funded`}
                    />
                  ) : (
                    <div
                      class="unknown-progress"
                      role="img"
                      aria-label="Funding progress not yet confirmed"
                    />
                  )}

                  <p>
                    {eventProgress
                      ? eventProgress.remaining === 0
                        ? '♡ Fully funded—thank you, family.'
                        : `${money(eventProgress.remaining)} still needed`
                      : 'Funding update coming soon'}
                  </p>
                </section>
              )
            }

            {
              state === 'funding' && (
                <section class="event-detail-help">
                  <h2>Help make it happen</h2>

                  {methods.length ? (
                    <>
                      <p>
                        Choose whichever option is easiest. Please include “{e.child} –
                        {e.title}” in your payment note.
                      </p>

                      <div class="event-payment-options">
                        {methods.map(([key, method]) =>
                          key === 'zelle' ? (
                            <div class="event-payment-static">
                              <strong>Zelle</strong>
                              <span>{method.destination}</span>
                            </div>
                          ) : (
                            <a
                              class="button dark-button"
                              href={method.url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              Continue with {providerNames[key] || key}{' '}
                              <span aria-hidden="true">↗</span>
                            </a>
                          )
                        )}
                      </div>

                      <small>
                        Payments take place with your provider. Funding totals are updated by
                        the family.
                      </small>
                    </>
                  ) : (
                    <p>Contribution details are coming soon. Please check back.</p>
                  )}
                </section>
              )
            }

            <section class="event-supporter-thanks" aria-labelledby="supporter-thanks-title">
              <p class="eyebrow">LOVE FROM OUR VILLAGE</p>
              <h2 id="supporter-thanks-title">Thank you for showing up.</h2>

              {
                e.contributors?.length > 0 ? (
                  <div class="supporter-badges">
                    {e.contributors.map((name) => (
                      <span class="supporter-badge">
                        <span aria-hidden="true">♡</span>
                        {name}
                      </span>
                    ))}
                  </div>
                ) : (e.raised ?? 0) > 0 ? (
                  <div class="supporter-badges">
                    <span class="supporter-badge">
                      <span aria-hidden="true">♡</span> Thank you, our village
                    </span>
                  </div>
                ) : (
                  <div class="event-thanks-empty">
                    <span aria-hidden="true">♡</span>
                    <p>
                      No public thank-yous yet. When someone contributes, we’ll add their
                      name here with permission.
                    </p>
                  </div>
                )
              }

              <small>Names are shared with permission. Contribution amounts stay private.</small>
            </section>

            {
              album && (
                <a
                  class="button help-button event-album-link"
                  href={album}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View photo album ↗
                </a>
              )
            }
          </div>
        </article>

        {gallery.filter((photo) => photo.src !== cover).length > 0 && (
          <section class="event-detail-gallery">
            <h2>More from this moment</h2>
            <div>
              {gallery
                .filter((photo) => photo.src !== cover)
                .map((photo) => (
                  <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                ))}
            </div>
          </section>
        )}
      </div>
    </main>

    <footer class="wrap">
      <a class="brand footer-brand" href="/">
        <span class="monogram">M<span>•</span></span>
        The Martin Family
      </a>
      <p>It takes a village.</p>
      <a href="/">Family home ↑</a>
    </footer>
  </body>
</html>
