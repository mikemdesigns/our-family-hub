---
import {generalSupportPool} from '../lib/events.mjs';
---
<section class="general-support wrap" aria-labelledby="general-support-title">
 <span class="general-support-heart" aria-hidden="true">♡</span>
 <div>
  <p class="eyebrow">ONE POOL, LOTS OF LOVE</p>
  <h2 id="general-support-title">Just want to support the family?</h2>
  <p>No need to choose a specific moment. Our general support pool lets us put your kindness wherever it can help most.</p>
 </div>
 <a class="button dark-button" href={generalSupportPool} target="_blank" rel="noopener noreferrer">Give to the general pool <span aria-hidden="true">↗</span></a>
</section>
