# Copy this file to .env and replace the examples with your DreamHost values.
DREAMHOST_HOST=YOUR_SERVER.dreamhost.com
DREAMHOST_USER=YOUR_SHELL_USER
DREAMHOST_PATH=/home/YOUR_SHELL_USER/YOUR_DOMAIN

# Optional. Use an absolute path when SSH should use a specific private key.
DREAMHOST_SSH_KEY_FILE=/Users/YOUR_MAC_USER/.ssh/id_ed25519
