# Copy this file to .env and replace the examples with your DreamHost values.
DREAMHOST_HOST=YOUR_SERVER.dreamhost.com
DREAMHOST_USER=YOUR_SHELL_USER
DREAMHOST_PATH=/home/YOUR_SHELL_USER/YOUR_DOMAIN

# Optional. Use an absolute path when SSH should use a specific private key.
DREAMHOST_SSH_KEY_FILE=/Users/YOUR_MAC_USER/.ssh/id_ed25519

# Set these in the production web server environment for the family signup relay.
# They are read by public/api/family-signup.php and are never included in browser JavaScript.
MAUTIC_BASE_URL=https://mautic.example.com
MAUTIC_FORM_ID=123

# Only change these if the field API names in Mautic's Manual Copy HTML differ.
MAUTIC_FIRST_NAME_ALIAS=firstname
MAUTIC_EMAIL_ALIAS=email
